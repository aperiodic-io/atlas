# Which 1Password Environment backs this directory.
#
# Committed on purpose: it names an Environment, it holds no secrets.
#
#   op-env run -- <cmd>   run with the variables injected (nothing hits disk)
#   op-env print          show them
#   op-env write          materialise a gitignored .env, if a tool needs a file
#   op-env check          diagnose
#
# op-env lives in https://github.com/szemyd/ssh-llm-setup
OP_ENVIRONMENT_NAME=aperiodic-io/atlas

# Optional: pin the Environment ID if name resolution is unavailable.
# 1Password -> Developer -> View Environments -> Manage environment -> Copy ID.
#OP_ENVIRONMENT_ID=
